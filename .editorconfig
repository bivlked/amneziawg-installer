root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash,bats}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Hash-pinned test fixtures: keep bytes as they are
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = false
